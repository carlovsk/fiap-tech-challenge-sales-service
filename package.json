{
  "name": "fiap-tech-challenge-sales-service",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts --max-warnings 0",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:integration": "./scripts/run-integration-tests.sh",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:docker": "docker-compose exec app npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio"
  },
  "eslintConfig": {
    "extends": "./.eslintrc.cjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.0.11",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.1",
    "prisma": "^6.10.1",
    "tslog": "^4.10.2",
    "tsx": "^4.20.3",
    "type-fest": "^4.34.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.28.0"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "axios": "^1.13.2",
    "express": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "license": "ISC"
}
